# Compte de développement local uniquement. Ne pas réutiliser en hébergement.
DATABASE_URL=postgresql://cometernel:local_dev_only@127.0.0.1:55432/cometernel
TEST_DATABASE_URL=postgresql://cometernel:local_dev_only@127.0.0.1:55432/cometernel_test

# Générer un secret local avec npm run auth:setup (ne pas versionner).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3100
AUTH_MAIL_MODE=local
# Facultatifs, connexion Google désactivée sans ces deux valeurs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stockage privé : local pour le pilote sur cet ordinateur.
STORAGE_DRIVER=local
PRIVATE_STORAGE_PATH=.private-media
# Pour un bucket S3 privé configuré par l'exploitant :
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Hébergement public : renseigner dans le gestionnaire de secrets du serveur.
# COMETERNEL_DEPLOYMENT=public
# BETTER_AUTH_URL=https://votre-domaine
# AUTH_MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PORT=3000
# Le mode public exige S3 privé et SMTP TLS. Ne pas réutiliser les secrets locaux.

# Classement des envois directs Drive. Secret serveur partagé avec n8n (32 caractères minimum).
N8N_SERVICE_TOKEN=
# URL HTTPS du webhook de production n8n, jamais une URL webhook-test.
N8N_DIRECT_DRIVE_WEBHOOK_URL=

# Compatibilité des anciennes copies uniquement. Aucun compte Google global pour les nouveaux envois.
# N8N_ORGANIZATION_ID=
# GOOGLE_DRIVE_FOLDER_ID=

# Chaque compte vérifié peut créer son association. Aucun email propriétaire global.
