{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cometernel:n8n-drive-test:v1",
  "title": "ComÉternel — contrat n8n Drive v1",
  "description": "Schemas des corps JSON. Choisir le $defs correspondant à la route. Aucun secret dans le corps ou dans l’URL.",
  "$defs": {
    "googleId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{10,200}$" },
    "claimRequest": {
      "type": "object", "required": ["requestId"], "additionalProperties": false,
      "properties": { "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" } }
    },
    "job": {
      "type": "object", "required": ["id", "leaseId", "mediaId", "name", "mime", "size", "sha256", "folderId", "driveFileId"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "leaseId": { "type": "string", "format": "uuid" },
        "mediaId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "mime": { "enum": ["image/jpeg", "image/png", "image/webp", "video/mp4", "application/pdf"] },
        "size": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "folderId": { "$ref": "#/$defs/googleId" },
        "driveFileId": { "anyOf": [{ "$ref": "#/$defs/googleId" }, { "type": "null" }] }
      }
    },
    "claimResponse": {
      "type": "object", "required": ["job"],
      "properties": { "job": { "anyOf": [{ "$ref": "#/$defs/job" }, { "type": "null" }] } }
    },
    "reserveRequest": {
      "type": "object", "required": ["leaseId", "driveFileId"], "additionalProperties": false,
      "properties": { "leaseId": { "type": "string", "format": "uuid" }, "driveFileId": { "$ref": "#/$defs/googleId" } }
    },
    "reserveResponse": {
      "type": "object", "required": ["driveFileId"],
      "properties": { "driveFileId": { "$ref": "#/$defs/googleId" } }
    },
    "driveFile": {
      "type": "object", "required": ["id", "mimeType", "size", "sha256Checksum", "parents", "trashed", "appProperties"],
      "properties": {
        "id": { "$ref": "#/$defs/googleId" },
        "name": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+$" },
        "sha256Checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parents": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/googleId" } },
        "trashed": { "const": false },
        "appProperties": { "type": "object", "required": ["cometernelJob"], "properties": { "cometernelJob": { "type": "string", "format": "uuid" } } }
      }
    },
    "resultRequest": {
      "oneOf": [
        { "type": "object", "required": ["leaseId", "status", "driveFile"], "additionalProperties": false, "properties": { "leaseId": { "type": "string", "format": "uuid" }, "status": { "const": "succeeded" }, "driveFile": { "$ref": "#/$defs/driveFile" } } },
        { "type": "object", "required": ["leaseId", "status", "errorCode"], "additionalProperties": false, "properties": { "leaseId": { "type": "string", "format": "uuid" }, "status": { "const": "failed" }, "errorCode": { "enum": ["transfer_failed", "metadata_mismatch", "source_unavailable"] } } }
      ]
    },
    "resultResponse": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["succeeded", "failed"] } } }
  }
}
