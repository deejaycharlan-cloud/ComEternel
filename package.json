{
  "name": "com-eternel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env.local --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "auth:setup": "tsx scripts/auth-setup.ts",
    "auth:assign-space": "tsx --env-file=.env.local scripts/assign-legacy-space.ts",
    "backup:local": "tsx --env-file=.env.local scripts/backup-local.ts",
    "pilot:local": "tsx --env-file=.env.local scripts/preview-pilot.ts --serve-only",
    "test:restore": "tsx --env-file=.env.local scripts/restore-rehearsal.ts",
    "check:deployment": "node --import tsx scripts/check-deployment.ts",
    "start:public": "npm run check:deployment && next start --hostname 0.0.0.0",
    "db:migrate:public": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hash-wasm": "4.12.0",
    "next": "16.3.5",
    "nodemailer": "10.0.9",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
